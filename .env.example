# Axyntrax Core - Environment Configuration Example
# Define this environment variable before starting the application.
# Note: .env files are not loaded automatically by default.
# PowerShell: $env:AXYNTRAX_SIGNING_SECRET="your-32-byte-secret-key-here"
# Linux/macOS: export AXYNTRAX_SIGNING_SECRET="your-32-byte-secret-key-here"

AXYNTRAX_SIGNING_SECRET=replace_with_secure_random_key_for_hmac_signing
